generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMINISTRADOR
  EDITOR
  REDACCTOR
  MODERADOR
  INVITADO
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING
}

enum DonationStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  ARCHIVE
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  avatar        String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roleId  String
  role    Role   @relation(fields: [roleId], references: [id])

  news                  News[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  biodiversityObservations BiodiversityObservation[]
  speciesIdentifications  SpeciesIdentification[]
  documentAnalyses        DocumentAnalysis[]
  activityPlans           ActivityPlan[]
  siaCitizenObservations  SiaCitizenObservation[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  key         String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  type        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news News[]

  @@map("categories")
}

model News {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String?
  coverImage    String?
  status        ContentStatus @default(DRAFT)
  featured      Boolean       @default(false)
  author        String?
  publishedAt   DateTime?
  language      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("news")
}

model Program {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  content     String?
  coverImage  String?
  icon        String?
  category    String?
  status      ContentStatus @default(DRAFT)
  order       Int           @default(0)
  language    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("programs")
}

model Project {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  content     String?
  coverImage  String?
  region      String?
  location    String?
  budget      Float?
  status      ContentStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  progress    Int           @default(0)
  language    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("projects")
}

model Species {
  id                 String        @id @default(uuid())
  name               String
  scientificName     String?
  slug               String        @unique
  description        String?
  category           String?
  conservationStatus String?
  habitat            String?
  region             String?
  image              String?
  characteristics    Json?
  threats            String[]
  conservationActions String[]
  language           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("species")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  date        DateTime?
  tags        String[]
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images GalleryImage[]

  @@map("galleries")
}

model GalleryImage {
  id        String @id @default(uuid())
  src       String
  alt       String?
  caption   String?
  order     Int    @default(0)

  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model Event {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  description     String?
  date            DateTime?
  startTime       String?
  endTime         String?
  location        String?
  type            String?
  coverImage      String?
  organizer       String?
  capacity        Int?
  registeredCount Int         @default(0)
  status          EventStatus @default(UPCOMING)
  tags            String[]
  language        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("events")
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String?
  fileSize    String?
  format      String?
  category    String?
  icon        String?
  downloads   Int      @default(0)
  featured    Boolean  @default(false)
  language    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("resources")
}

model Partner {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  description String?
  website     String?
  type        String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partners")
}

model Volunteer {
  id           String           @id @default(uuid())
  name         String
  email        String?
  phone        String?
  region       String?
  availability String?
  skills       String[]
  motivation   String?
  status       VolunteerStatus  @default(PENDING)
  registeredAt DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("volunteers")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String?
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String?
  bio       String?
  image     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model Testimonial {
  id        String   @id @default(uuid())
  quote     String?
  author    String
  role      String?
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  legalName    String?
  description  String?
  mission      String?
  vision       String?
  logo         String?
  logoAlt      String?
  address      String?
  phone        String?
  email        String?
  website      String?
  foundingYear Int?
  socialMedia  Json?
  values       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("organizations")
}

model ImpactMetric {
  id          String   @id @default(uuid())
  label       String
  value       String
  icon        String?
  description String?
  year        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("impact_metrics")
}

model Donation {
  id          String         @id @default(uuid())
  donorName   String?
  donorEmail  String?
  amount      Float
  currency    String         @default("PEN")
  method      String?
  status      DonationStatus @default(PENDING)
  message     String?
  isAnonymous Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("donations")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  type      String   @default("string")
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String       @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  metadata  Json?
  ipAddress String?
  severity  AuditSeverity @default(INFO)
  createdAt DateTime      @default(now())

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String?
  type      String   @default("info")
  read      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Upload {
  id          String   @id @default(uuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  url         String?
  provider    String   @default("local")
  bucket      String?
  createdAt   DateTime @default(now())

  @@map("uploads")
}

model AiQueryLog {
  id          String   @id @default(uuid())
  feature     String
  query       String
  provider    String
  model       String
  tokensUsed  Int      @default(0)
  cost        Float    @default(0)
  latencyMs   Int      @default(0)
  success     Boolean  @default(true)
  userId      String?
  error       String?
  createdAt   DateTime @default(now())

  @@map("ai_query_logs")
}

enum ObservationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum UserLevel {
  PRIMARY
  SECONDARY
  UNIVERSITY
  TEACHER
  RESEARCHER
  VOLUNTEER
  COMPANY
  GENERAL
}

model BiodiversityObservation {
  id            String            @id @default(uuid())
  speciesName   String?
  scientificName String?
  quantity      Int               @default(1)
  latitude      Float
  longitude     Float
  observedAt    DateTime
  habitat       String?
  weather       String?
  comments      String?
  images        String[]
  status        ObservationStatus @default(PENDING)
  confidence    Float?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@map("biodiversity_observations")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  title       String
  content     String
  source      String
  sourceType  String
  category    String?
  tags        String[]
  embedding   Float[]
  metadata    Json?
  isVerified  Boolean  @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("knowledge_base")
}

model SpeciesIdentification {
  id              String   @id @default(uuid())
  imageUrl        String?
  scientificName  String?
  commonName      String?
  confidence      Float?
  conservationStatus String?
  habitat         String?
  distribution    String?
  curiosities     String[]
  threats         String[]
  ecologicalImportance String?
  source          String   @default("image")
  metadata        Json?
  createdAt       DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("species_identifications")
}

model DocumentAnalysis {
  id           String   @id @default(uuid())
  filename     String
  fileType     String
  fileSize     Int
  content      String?
  summary      String?
  concepts     Json?
  questions    Json?
  mindMap      Json?
  glossary     Json?
  activities   Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("document_analyses")
}

model ActivityPlan {
  id          String   @id @default(uuid())
  title       String
  activityType String
  description String?
  content     Json?
  level       String   @default("general")
  duration    String?
  objectives  String[]
  materials   String[]
  steps       Json?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("activity_plans")
}

model CertificateTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  title     String
  content   String
  variables String[]
  layout    String   @default("default")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certificate_templates")
}

model IssuedCertificate {
  id               String   @id @default(uuid())
  recipientName    String
  recipientEmail   String?
  certificateType  String
  templateId       String?
  programName      String
  hours            String?
  eventDate        String?
  verificationCode String   @unique
  verificationUrl  String?
  qrDataUrl        String?
  metadata         Json?
  issuedAt         DateTime @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  @@map("issued_certificates")
}

enum SiaIndicatorCategory {
  EDUCACION
  AMBIENTAL
  SOCIAL
  ECONOMICO
  PARTICIPACION
  CONSERVACION
}

enum SiaAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SiaAlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
  ARCHIVED
}

enum SiaReportType {
  INSTITUCIONAL
  CAMPANA
  PROYECTO
  EDUCATIVO
  BIODIVERSIDAD
}

enum SiaReportFormat {
  PDF
  EXCEL
  CSV
}

enum SiaDatasetVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum SiaObservationStatus {
  PENDING
  VALIDATED
  APPROVED
  REJECTED
  NEEDS_CORRECTION
}

model SiaIndicator {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String?
  category    SiaIndicatorCategory
  unit        String?
  formula     String?
  source      String?
  target      Float?
  current     Float?
  year        Int?
  region      String?
  institution String?
  configurable Boolean             @default(true)
  active      Boolean             @default(true)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  records   SiaIndicatorRecord[]
  alertRules SiaAlertRule[]

  @@map("sia_indicators")
}

model SiaIndicatorRecord {
  id          String   @id @default(uuid())
  value       Float
  date        DateTime
  region      String?
  institution String?
  metadata    Json?
  createdAt   DateTime @default(now())

  indicatorId String
  indicator   SiaIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@map("sia_indicator_records")
}

model SiaAlertRule {
  id          String          @id @default(uuid())
  name        String
  description String?
  condition   String
  threshold   Float
  severity    SiaAlertSeverity @default(MEDIUM)
  status      SiaAlertStatus   @default(ACTIVE)
  channel     String           @default("email")
  cooldown    Int              @default(3600)
  lastTriggeredAt DateTime?
  config      Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  indicatorId String?
  indicator   SiaIndicator? @relation(fields: [indicatorId], references: [id])
  logs        SiaAlertLog[]

  @@map("sia_alert_rules")
}

model SiaAlertLog {
  id          String          @id @default(uuid())
  message     String
  severity    SiaAlertSeverity @default(MEDIUM)
  read        Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())

  ruleId String?
  rule   SiaAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@map("sia_alert_logs")
}

model SiaReport {
  id            String         @id @default(uuid())
  title         String
  type          SiaReportType
  description   String?
  format        SiaReportFormat?
  fileUrl       String?
  generatedAt   DateTime?
  filters       Json?
  metadata      Json?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("sia_reports")
}

model SiaGeozone {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("region")
  description String?
  geometry    Json?
  centerLat   Float?
  centerLng   Float?
  zoom        Int?
  color       String   @default("#10b981")
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sia_geozones")
}

model SiaDataset {
  id          String               @id @default(uuid())
  title       String
  slug        String               @unique
  description String?
  category    String?
  source      String?
  format      String?
  fileUrl     String?
  metadata    Json?
  visibility  SiaDatasetVisibility @default(PUBLIC)
  downloads   Int                  @default(0)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("sia_datasets")
}

model SiaCitizenObservation {
  id              String              @id @default(uuid())
  speciesName     String?
  scientificName  String?
  quantity        Int                 @default(1)
  latitude        Float
  longitude       Float
  observedAt      DateTime
  habitat         String?
  weather         String?
  comments        String?
  images          String[]
  status          SiaObservationStatus @default(PENDING)
  confidence      Float?
  reviewedBy      String?
  reviewedAt      DateTime?
  assignedTo      String?
  revisionHistory Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("sia_citizen_observations")
}

enum TranslationStatus {
  DRAFT
  REVIEWING
  TRANSLATED
  PUBLISHED
  OBSOLETE
}

enum LanguageCode {
  es
  en
  pt
  shp
  cni
  pug
  qu
}

model Language {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  nativeName String?
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  flag       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations     ContentTranslation[]
  translationKeys  TranslationKey[]

  @@map("languages")
}

model ContentTranslation {
  id           String            @id @default(uuid())
  entityType   String
  entityId     String
  field        String
  value        String?
  languageId   String
  language     Language          @relation(fields: [languageId], references: [id])
  status       TranslationStatus @default(DRAFT)
  translatorId String?
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([entityType, entityId, field, languageId])
  @@map("content_translations")
}

model TranslationKey {
  id         String            @id @default(uuid())
  key        String
  namespace  String            @default("translation")
  value      String?
  languageId String
  language   Language          @relation(fields: [languageId], references: [id])
  status     TranslationStatus @default(DRAFT)
  context    String?
  maxLength  Int?
  group      String?
  tags       String[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([key, namespace, languageId])
  @@map("translation_keys")
}

model TranslationImport {
  id         String   @id @default(uuid())
  format     String
  filename   String
  languageId String?
  count      Int      @default(0)
  errors     Json?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@map("translation_imports")
}

model SiaMonitoringLog {
  id          String   @id @default(uuid())
  service     String
  status      String   @default("healthy")
  latency     Int?
  errorCount  Int      @default(0)
  message     String?
  metadata    Json?
  checkedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("sia_monitoring_logs")
}
