# Sembrando Huellas Perú — Environment Variables (Example)
# Copy this file to .env and fill in your values

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://user:password@host:5432/sembrando_huellas

JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_REFRESH_EXPIRATION=7d

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_access
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=sembrando-huellas
MINIO_USE_SSL=false

THROTTLE_TTL=60
THROTTLE_LIMIT=100

CORS_ORIGINS=https://sembrandohuellas.org

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sembrandohuellas.org

LOG_LEVEL=info
