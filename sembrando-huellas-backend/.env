# ─────────────────────────────────────────────────────────
# Sembrando Huellas Perú — Backend Environment Variables
# ─────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://sh_user:sh_password@localhost:5432/sembrando_huellas?schema=public

# JWT
JWT_SECRET=s3mbr4nd0-hu3ll4s-jwt-s3cr3t-k3y-ch4ng3-1n-pr0duct10n
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=s3mbr4nd0-hu3ll4s-r3fr3sh-s3cr3t-k3y
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (File Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=sh_minio
MINIO_SECRET_KEY=sh_minio_secret
MINIO_BUCKET=sembrando-huellas
MINIO_USE_SSL=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Email (prepared)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sembrandohuellas.org

# Logging
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────
# AI & Machine Learning
# ─────────────────────────────────────────────────────────

# Active provider: openai | gemini | claude | local
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Local (Ollama)
LOCAL_MODEL=llama3
LOCAL_BASE_URL=http://localhost:11434

# AI Defaults
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_COST_LIMIT=50
AI_RATE_LIMIT=100

# Vector Store: memory | pgvector | qdrant
VECTOR_STORE=memory
