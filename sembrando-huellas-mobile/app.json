{
  "expo": {
    "name": "Sembrando Huellas Perú",
    "slug": "sembrando-huellas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sembrandohuellas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.sembrandohuellas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Se necesita acceso a la cámara para identificar especies",
        "NSPhotoLibraryUsageDescription": "Se necesita acceso a la galería para subir fotos",
        "NSLocationWhenInUseUsageDescription": "Se necesita ubicación para registrar observaciones"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10b981",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "org.sembrandohuellas.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#10b981"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Se necesita acceso a la cámara para identificar especies"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se necesita ubicación para registrar observaciones"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se necesita acceso a la galería para subir fotos"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
